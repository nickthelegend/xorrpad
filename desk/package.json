{
  "name": "xorr-pad-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The xorr-pad desk app: hosts the trading backend the pad talks to, and shows what the agent remembers.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:backtest": "node --test test/backtest*.test.mjs",
    "test:agent": "node --test test/agent.test.mjs test/agent.http.test.mjs",
    "test:memory": "node test/memory.test.mjs",
    "test:loadbearing": "node test/loadbearing.test.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "start": "electron .",
    "backend": "node --env-file-if-exists=../.env main/server.mjs",
    "shots": "electron shots.mjs",
    "verify": "node test/verify.mjs",
    "warm": "node warm.mjs",
    "icon": "python3 build/make-icon.py",
    "dist": "python3 build/make-icon.py && electron-builder --mac --arm64",
    "pack": "electron-builder --dir",
    "test:ui": "node test/desk-ui.mjs",
    "build:app": "npm run build --workspace app",
    "prestart": "npm run build:app",
    "predist": "npm run build:app",
    "pretest": "npm run build:app",
    "test:v2": "node test/desktop-v2.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anchor-lang/core": "1.0.1",
    "@ellipsis-labs/rise": "0.7.10",
    "@meteora-ag/dlmm": "1.9.14",
    "@pm-amm/sdk": "0.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "opusscript": "0.1.1",
    "serialport": "^13.0.0",
    "ws": "8.21.3"
  },
  "main": "main/electron.mjs",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.65.0"
  },
  "build": {
    "appId": "finance.xorr.pad",
    "productName": "xorr-pad",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.map",
      "!test/**",
      "!build/**",
      "!shots.mjs",
      "!warm.mjs",
      "!run-dev.sh",
      "app/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "memory",
        "to": "memory"
      },
      {
        "from": "../.venv",
        "to": ".venv"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    }
  },
  "author": "nickthelegend",
  "optionalDependencies": {
    "@abandonware/noble": "^1.9.2-26"
  },
  "workspaces": [
    "app"
  ]
}
