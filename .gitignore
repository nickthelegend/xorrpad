# Session wallet material is local only (including Node-only test/devnet runs).
session-wallet.node.key
session-wallet.encrypted
/desk/.t2-devnet/

/desk/.t4-devnet/

# OS-encrypted provider credentials are private app state.
*.encrypted
*.encrypted.*.tmp

# Firmware signing material must live outside the repository.
*.pem
*.key
firmware/keys/
firmware/*.bin
firmware/*.sig
.impeccable/review/

# Factory authority and certificate output (private material never belongs here).
**/factory-ed25519*
firmware/factory-keys/
*.device-cert.json
