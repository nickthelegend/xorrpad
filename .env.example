# Copy to `.env` and fill in. `.env` is gitignored — keys never get committed.

# Groq (STT + LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# Deepgram (TTS) — https://console.deepgram.com/
DEEPGRAM_API_KEY=

# --- Pad auth ---
# Shared secret the pad must present. Empty = off (OK on a trusted LAN).
# REQUIRED before exposing the backend to the internet (Tailscale Funnel):
#   PAD_TOKEN=$(openssl rand -hex 24)
# Put the same value in the pad's setup portal ("Pad token").
# PAD_TOKEN=

# --- STT provider ---
# STT_PROVIDER=deepgram          # or 'groq' (whisper) once your Groq project allows audio models

# --- optional overrides (defaults shown) ---
# PORT=8080
# HOST=0.0.0.0
# SAMPLE_RATE=16000
# STT_MODEL=nova-2               # Deepgram STT model
# GROQ_STT_MODEL=whisper-large-v3-turbo
# LLM_MODEL=llama-3.3-70b-versatile
# TTS_MODEL=aura-2-thalia-en
# MAX_TOKENS=160
# TIMEOUT_MS=20000
# SYSTEM_PROMPT=You are the voice of a desk macropad ...

PMAMM_RPC=
PMAMM_PUBLIC_URL=
PMAMM_TEST_OWNER=
SOLANA_PAY_PUBLIC_URL=

PHOENIX_AUTHORITY=
PHOENIX_RPC=
PHOENIX_PUBLIC_URL=
PHOENIX_TRADER_PDA_INDEX=
PHOENIX_SUBACCOUNT_INDEX=
KEEPER_RPC=
KEEPER_MINT=
KEEPER_DEPOSIT_USDC=
KEEPER_PUBLIC_KEY=
PYTH_API_KEY=

# Trade proposals expire after this many seconds (default 60).
XORR_SIGNAL_TTL_SECONDS=60
# Local session signing of mainnet is refused unless explicitly acknowledged.
# XORR_ALLOW_MAINNET=I_ACKNOWLEDGE_REAL_FUNDS
